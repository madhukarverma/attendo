rules_version = '2';

// Attendo friends. Paste into Firebase console › Firestore Database › Rules and click Publish.
//
// - Only Google accounts count as signed in (not anonymous or email/password accounts, even if
//   those are switched on in the console by mistake).
// - Profiles (name, friend code, programme) are visible to signed-in students, so they can search
//   (20 results per query at most). A profile's friend code must belong to its own account.
// - A friend list is visible to its owner and to the owner's friends.
// - Shared attendance / grades are visible to the owner and the owner's friends only; the app
//   deletes the document when the student turns sharing off (grades are off by default).
// - Friendships are created only by accepting a pending request, and either side can end them.
// - Timestamps must be the server's time, so no field can be stuffed with junk.
// - Feedback (Settings › Feedback) can be sent without signing in, but nobody can read, change or
//   delete it through the app; the developer reads it in the Firebase console.
// Tests: firebase/test/rules.test.mjs (npm test, on the local emulator).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // Set by the app with FieldValue.serverTimestamp(), which arrives as the request time.
    function now(v) {
      return v == request.time;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function areFriends(a, b) {
      return exists(/databases/$(database)/documents/users/$(a)/friends/$(b));
    }

    function pending(from, to) {
      return exists(/databases/$(database)/documents/requests/$(from + '_' + to));
    }

    function shortText(v, max) {
      return v is string && v.size() <= max;
    }

    // A friend code is the first 6 letters/digits of the account id, upper-case. Checking it stops
    // anyone from claiming a classmate's code.
    function ownCode(code, uid) {
      return code is string && code.matches('^[A-Z0-9]{6}$') && uid.upper().matches('^' + code + '.*');
    }

    function validProfile(d, uid) {
      return d.keys().hasOnly(['name', 'searchName', 'code', 'programme', 'updatedAt'])
        && shortText(d.name, 40) && d.name.size() > 0
        && shortText(d.searchName, 40)
        && ownCode(d.code, uid)
        && shortText(d.programme, 40)
        && now(d.updatedAt);
    }

    function validFeedback(d) {
      return d.keys().hasOnly(['rating', 'category', 'message', 'contact', 'app', 'versionCode', 'android', 'device', 'createdAt'])
        && d.rating is int && d.rating >= 0 && d.rating <= 5
        && d.category in ['bug', 'idea', 'praise', 'other']
        && d.message is string && d.message.size() <= 2000
        && (d.rating > 0 || d.message.size() >= 10)
        && (!('contact' in d) || shortText(d.contact, 100))
        && (!('app' in d) || shortText(d.app, 20))
        && (!('versionCode' in d) || d.versionCode is int)
        && (!('android' in d) || d.android is int)
        && (!('device' in d) || shortText(d.device, 60))
        && now(d.createdAt);
    }

    function validShared(d) {
      return d.keys().hasOnly(['overall', 'subjects', 'updatedAt'])
        && d.overall is number
        && d.subjects is list && d.subjects.size() <= 20
        && now(d.updatedAt);
    }

    match /users/{uid} {
      allow get: if signedIn();
      // Search only: at most 20 results per query, so nobody can download the whole student list.
      allow list: if signedIn() && request.query.limit <= 20;
      allow create, update: if isUser(uid) && validProfile(request.resource.data, uid);
      allow delete: if isUser(uid);

      match /friends/{fid} {
        allow read: if isUser(uid) || areFriends(uid, request.auth.uid);
        // Written by the student accepting a request, into both friend lists.
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['name', 'since'])
          && shortText(request.resource.data.name, 40)
          && now(request.resource.data.since)
          && ((request.auth.uid == uid && pending(fid, uid))
              || (request.auth.uid == fid && pending(uid, fid)));
        allow update: if false;
        allow delete: if isUser(uid) || isUser(fid);
      }

      match /shared/{doc} {
        allow read: if isUser(uid) || areFriends(uid, request.auth.uid);
        allow create, update: if isUser(uid) && doc in ['attendance', 'grades'] && validShared(request.resource.data);
        allow delete: if isUser(uid);
      }
    }

    match /feedback/{id} {
      allow create: if validFeedback(request.resource.data);
      // No read, update or delete: feedback is only visible in the Firebase console.
    }

    match /requests/{id} {
      allow read: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'fromName', 'fromCode', 'toName', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to
        && shortText(request.resource.data.fromName, 40)
        && shortText(request.resource.data.toName, 40)
        && ownCode(request.resource.data.fromCode, request.auth.uid)
        && now(request.resource.data.createdAt)
        && !areFriends(request.auth.uid, request.resource.data.to);
      allow update: if false;
      allow delete: if signedIn()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }
  }
}
