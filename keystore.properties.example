# Copy to keystore.properties (same folder) to sign release builds with Attendo's release key.
# keystore.properties is git-ignored: it holds the key's password. See docs/RELEASE_SIGNING.md.
# Use forward slashes in the path. A backslash in a password must be written as \\.
storeFile=C:/Users/<you>/android-dev/keys/attendo-release.jks
storePassword=
keyAlias=attendo
keyPassword=
